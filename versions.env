# Pinned third-party dependency versions for deep-infer.
#
# This file is the single source of truth for third-party versions and base
# images. It is plain KEY=VALUE so both shell scripts (`source`) and CMake
# (parsed in CMakeLists.txt) can consume it without shell evaluation.
#
# Rules:
#   - One KEY=VALUE per line; no `export`, command substitution, or quotes.
#   - Values must not contain spaces.
#   - Consumers allow overrides, e.g. ${VAR:-<pinned value>}.

# --- neuriplo-tasks (fetched by CMake FetchContent) ---
NEURIPLO_TASKS_REPO=https://github.com/olibartfast/neuriplo-tasks.git
NEURIPLO_TASKS_VERSION=v0.8.2

# --- Build toolchain ---
CMAKE_MIN_VERSION=3.19
CUDA_MIN_VERSION=13.1
TENSORRT_MIN_VERSION=10.14
GSTREAMER_VERSION=1.24.2
OPENCV_MIN_VERSION=4.6

# --- Platform baselines ---
UBUNTU_VERSION=24.04
JETPACK_VERSION=7.2
L4T_VERSION=R39.2

# --- DeepStream ---
DEEPSTREAM_INSTALL_ROOT=/opt/nvidia/deepstream
DEEPSTREAM_BASELINE_VERSION=9.1
DEEPSTREAM_FALLBACK_VERSION=9.0

# --- NGC DeepStream base images ---
NGC_IMAGE_X86_DS9_1=nvcr.io/nvidia/deepstream:9.1-triton-multiarch
NGC_IMAGE_X86_DS9_0=nvcr.io/nvidia/deepstream:9.0-triton-multiarch
NGC_IMAGE_X86_DS8_0=nvcr.io/nvidia/deepstream:8.0-gc-triton-devel
NGC_IMAGE_JETSON_DS9_1=nvcr.io/nvidia/deepstream:9.1-triton-multiarch
NGC_IMAGE_JETSON_DS9_0=nvcr.io/nvidia/deepstream:9.0-triton-multiarch
NGC_IMAGE_JETSON_DS7_1=nvcr.io/nvidia/deepstream:7.1-samples-multiarch
NGC_IMAGE_JETSON_DS7_0=nvcr.io/nvidia/deepstream:7.0-triton-multiarch

# --- CI base image ---
# Build-only toolchain for the DeepStream-less stub pipeline. Intentionally
# older than CUDA_MIN_VERSION / UBUNTU_VERSION (the DeepStream 9.1 baseline);
# CI does not build the full SDK pipeline.
CI_CUDA_IMAGE=nvidia/cuda:12.6.2-devel-ubuntu22.04
